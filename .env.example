# Backend API base url. Copy this file to .env.local.
#
# Local only:
#   NEXT_PUBLIC_API_URL=http://localhost:7000/api/v1
#
# Sharing with the client over the tunnel — the browser running this code is
# the client's, not ours, so localhost would point at their machine:
NEXT_PUBLIC_API_URL=https://sabbir7000.ssh.bd/api/v1
